    "tt_gearmotor_200rpm": {
      "id": "tt_gearmotor_200rpm",
      "name": "TT DC Gearmotor (3-6V, 200 RPM, 1:48)",
      "category": "dc_motor",
      "mujoco": {
        "joint_type": "hinge",
        "axis": [0, 1, 0],
        "damping": 0.08,
        "armature": 0.005,
        "actuator_type": "velocity",
        "kv": 0.8,
        "ctrlrange": [-20.94, 20.94],
        "forcerange": [-3.5, 3.5],
        "mass_kg": 0.028,
        "size_m": [0.07, 0.0188, 0.0225],
        "rgba": [0.95, 0.8, 0.1, 1.0]
      },
      "mcu": {
        "requires_driver": "l298n",
        "max_rads": 20.94,
        "deadzone_pwm": 115,
        "max_pwm": 200,
        "reason": "TPU tires + 1:48 plastic gearbox + 1.4V L298N drop require PWM >= 115 to overcome static Coulomb friction."
      }
    },
    "sg90_servo": {
      "id": "sg90_servo",
      "name": "TowerPro SG90 Micro Servo (180° Pan/Tilt)",
      "category": "servo",
      "mujoco": {
        "joint_type": "hinge",
        "axis": [0, 0, 1],
        "range_rad": [-1.5708, 1.5708],
        "damping": 0.04,
        "armature": 0.002,
        "actuator_type": "position",
        "kp": 4.5,
        "ctrlrange": [-1.5708, 1.5708],
        "forcerange": [-0.6, 0.6],
        "mass_kg": 0.009,
        "size_m": [0.0126, 0.0232, 0.022],
        "rgba": [0.1, 0.38, 0.82, 1.0]
      },
      "mcu": {
        "required_pins": ["SIGNAL"],
        "library": "Servo.h",
        "locks_timer_on_arduino_uno": "Timer1",
        "disables_pwm_pins_on_arduino_uno": [9, 10],
        "slew_rate_deg_per_s": 500,
        "blocking_pitfall_ms": 350,
        "reason": "Attaching <Servo.h> on ATmega328P hijacks 16-bit Timer1, disabling analogWrite() PWM on pins D9 and D10."
      }
    },
